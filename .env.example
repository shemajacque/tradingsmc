# Copy to .env and change the password. Never commit .env.
SMC_ADMIN_PASSWORD=replace-with-a-long-random-password
SMC_DEMO_ONLY=1
# Set to 1 when the app is served over HTTPS (recommended for hosting)
SMC_COOKIE_SECURE=0
SMC_SESSION_HOURS=12
SMC_HEARTBEAT_SEC=30
# Local Windows MT5 bridge (enable only when the app runs beside MT5)
SMC_MT5_DIRECT=0
# Manual trades on a real account (keep 0)
SMC_ALLOW_LIVE_TRADING=0
